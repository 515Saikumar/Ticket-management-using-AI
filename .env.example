# Copy this to .env.local and fill in your Supabase values
# DO NOT commit the actual .env.local file

# Supabase project URL — from Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase ANON key (safe for frontend — row-level security must be enabled)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
